{
  "name": "clickguide",
  "version": "0.1.0",
  "private": true,
  "description": "Gemma 4-powered verified browser automation assistant",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "test": "npm --workspace=backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
